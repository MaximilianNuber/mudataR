\if{html}{\out{<a id="method-AbstractMuData-as_SingleCellExperiment"></a>}}
\if{latex}{\out{\hypertarget{method-AbstractMuData-as_SingleCellExperiment}{}}}
\subsection{\code{AbstractMuData$as_SingleCellExperiment()}}{
  Convert to a \code{SingleCellExperiment}: one modality (\code{main},
by default \code{"rna"}) becomes the main experiment, every other
modality an \code{altExp()} of the same name. Each modality is converted
with \code{anndataR::as_SingleCellExperiment()} using its entry in
\code{mod_args}.

Global \code{obs} columns are added to the main \code{colData} (prefixed with
\verb{mudata:} on a name clash), global \code{obsm} matrices become
\code{reducedDims} of the main experiment, and global \code{uns}/\code{obsm} are kept
in \code{metadata(sce)$mudata}. Awkward Arrays (e.g. scirpy AIRR data) are
kept in \verb{metadata(<experiment>)$awkward_obsm}.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{AbstractMuData$as_SingleCellExperiment(
  main = NULL,
  mod_args = list(),
  join = c("intersect", "main")
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{main}}{Name of the modality used as the main experiment. Defaults
to \code{"rna"} if present, otherwise the first modality.}
      \item{\code{mod_args}}{Named list with one list of
\code{anndataR::as_SingleCellExperiment()} arguments per modality, e.g.
\code{list(rna = list(x_mapping = "counts"), prot = list(x_mapping = "X"))}.
Modalities not listed use anndataR's defaults.}
      \item{\code{join}}{Which cells to keep. \code{"intersect"} (default): cells present
in every modality. \code{"main"}: every cell of \code{main}; altExps are padded
with \code{NA} for cells they lack and get a logical \code{present} column.
Either way, cells keep the order they have in \code{main}.}
    }
    \if{html}{\out{</div>}}
  }
}

